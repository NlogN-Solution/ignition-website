# The committed default is PRODUCTION, on purpose.
#
# This file is tracked, so whatever is in it is what a deploy reads when the
# hosting platform has no environment variable of its own — and it used to say
# `localhost:8001/api/v1`. On Vercel that only stayed harmless because a
# dashboard variable happened to override it; remove that variable, or build a
# preview branch that does not inherit it, and every one of the 125 prerendered
# pages reads a machine that is not there.
#
# Local development overrides this in `.env.local`, which is gitignored:
#
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8001/api/v1
#
NEXT_PUBLIC_API_BASE_URL=https://ignition-backend-2ste.onrender.com/api/v1
